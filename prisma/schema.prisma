generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum BadgeStatus {
  ACTIVE
  INACTIVE
}

enum RoadmapNodeType {
  LESSON
  QUIZ
  REWARD
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  // Legacy field retained; Better Auth stores credential hashes in Account.password.
  passwordHash  String?
  emailVerified Boolean  @default(false)
  avatarUrl     String?
  bio           String?
  role          UserRole @default(STUDENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enrollments       Enrollment[]
  lessonProgress    LessonProgress[]
  quizAttempts      QuizAttempt[]
  badges            UserBadge[]
  youtubeConnection YouTubeConnection?
  sessions          Session[]
  accounts          Account[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  password              String?
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AuthThrottle {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
}

model Course {
  id                String       @id @default(cuid())
  slug              String       @unique
  title             String
  shortDescription  String
  description       String
  thumbnailUrl      String?
  level             CourseLevel  @default(BEGINNER)
  status            CourseStatus @default(DRAFT)
  instructorName    String
  // Minutes; lesson durations use seconds.
  estimatedDuration Int?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  modules      Module[]
  enrollments  Enrollment[]
  quizzes      Quiz[]
  roadmapNodes RoadmapNode[]

  @@index([status])
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]
  quizzes Quiz[]

  @@unique([courseId, order])
}

model Lesson {
  id              String       @id @default(cuid())
  slug            String       @unique
  moduleId        String
  title           String
  description     String
  videoUrl        String
  thumbnailUrl    String?
  durationSeconds Int
  order           Int
  status          LessonStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]
  roadmapNodes   RoadmapNode[]

  @@unique([moduleId, order])
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  enrolledAt  DateTime  @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id          String               @id @default(cuid())
  userId      String
  lessonId    String
  status      LessonProgressStatus @default(NOT_STARTED)
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime             @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model Quiz {
  id          String     @id @default(cuid())
  slug        String     @unique
  courseId    String
  moduleId    String?
  title       String
  description String?
  passScore   Int        @default(80)
  status      QuizStatus @default(DRAFT)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module       Module?       @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  questions    Question[]
  attempts     QuizAttempt[]
  roadmapNodes RoadmapNode[]

  @@index([courseId])
  @@index([moduleId])
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  text        String
  order       Int
  explanation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quiz    Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options AnswerOption[]
  answers QuizAnswer[]

  @@unique([quizId, order])
}

model AnswerOption {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  QuizAnswer[]

  @@unique([questionId, order])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  // Unfinished attempts have no score or pass/fail decision.
  score       Float?
  passed      Boolean?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Restrict)
  answers QuizAnswer[]

  @@index([userId, quizId, startedAt])
  @@index([quizId])
}

model QuizAnswer {
  id               String  @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean

  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  question       Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  selectedOption AnswerOption @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@index([selectedOptionId])
}

model Badge {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  description    String
  icon           String
  conditionType  String
  conditionValue Int?
  status         BadgeStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  users        UserBadge[]
  roadmapNodes RoadmapNode[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@unique([userId, badgeId])
  @@index([badgeId])
}

model RoadmapNode {
  id        String          @id @default(cuid())
  courseId  String
  type      RoadmapNodeType
  title     String
  order     Int
  lessonId  String?
  quizId    String?
  badgeId   String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  course Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  quiz   Quiz?   @relation(fields: [quizId], references: [id], onDelete: Restrict)
  badge  Badge?  @relation(fields: [badgeId], references: [id], onDelete: Restrict)

  @@unique([courseId, order])
  @@index([lessonId])
  @@index([quizId])
  @@index([badgeId])
}

model YouTubeConnection {
  id                    String    @id @default(cuid())
  userId                String    @unique
  channelId             String
  channelTitle          String
  subscriberCount       BigInt?
  videoCount            BigInt?
  viewCount             BigInt?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  expiresAt             DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
